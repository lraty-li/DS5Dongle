CONFIG_NEWLIB               =n
CONFIG_NEWLIB_STANDARD      =n

CONFIG_VSNPRINTF_NANO       =n
CONFIG_VSNPRINTF_FLOAT      =y
CONFIG_VSNPRINTF_FLOAT_EX   =y
CONFIG_VSNPRINTF_LONG_LONG  =y
CONFIG_SCANF_FLOAT          =y
CONFIG_SCANF_FLOAT_EX       =y

CONFIG_BFLB_LOG              =n

# Keep the SDK, Bluetooth stack and Opus fixed-point codec at the validated
# -O2 setting.  E907 measurements showed that -O3 regresses this codec's
# content-dependent real-time latency despite producing a larger binary.
CONFIG_GCC_OPTIMISE_LEVEL    =-O2

# Opus clears several working buffers per frame.  Use aligned word stores in
# the SDK libc implementation instead of its default byte-at-a-time loop.
CONFIG_MEMSET_OPTSPEED       =y

CONFIG_FREERTOS              =y
CONFIG_BLUETOOTH             =y
CONFIG_RF                    =y
CONFIG_MULTIMEDIA            =y
CONFIG_OPUS                  =y

CONFIG_CHERRYUSB             =y
CONFIG_CHERRYUSB_OSAL        =freertos
CONFIG_CHERRYUSB_DEVICE      =y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM =y
CONFIG_CHERRYUSB_DEVICE_HID  =y
CONFIG_CHERRYUSB_DEVICE_AUDIO =y

CONFIG_BTBLECONTROLLER_LIB   =ble1m2s1bredr1
CONFIG_BT_BREDR              =y
CONFIG_BT_L2CAP_TX_MTU       =672

CONFIG_BT_A2DP               =n
CONFIG_BT_A2DP_SOURCE        =n
CONFIG_BT_AVRCP              =n
CONFIG_BT_HFP                =n
CONFIG_BT_SPP                =n
CONFIG_BT_MESH               =n

CONFIG_PARTITION             =y
CONFIG_BFLB_MTD              =y
CONFIG_LITTLEFS              =y
CONFIG_BT_SETTINGS           =y
CONFIG_BT_STACK_CLI          =n
CONFIG_BLE_TP_SERVER         =n
CONFIG_BT_TP_CLI             =n
CONFIG_SHELL                 =n

#CONFIG_LOG_DISABLE          =n
#CONFIG_ASSERT_DISABLE       =n
